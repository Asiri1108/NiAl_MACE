# Normalize text files in the Git repository.
* text=auto

# Keep cross-platform project files using LF line endings.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Keep Windows batch scripts using CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf