# Python virtual environments
.venv/
venv/
env/
**/.venv/

# Python generated files
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter generated files
.ipynb_checkpoints/

# IDE files
.vscode/

# Local environment files and secrets
.env
.env.*
!.env.example

# Training checkpoints and large model files
*.pt
*.pth
*.model
checkpoints/
runs/
logs/

# Step 6 relaxation manifests/logs are small scientific provenance artifacts,
# not training checkpoints. They are required for strict validation and resume.
!results/mace_relaxation/atomic_only/checkpoints/
!results/mace_relaxation/atomic_only/checkpoints/*.json
!results/mace_relaxation/atomic_only/logs/
!results/mace_relaxation/atomic_only/logs/*.log
!results/mace_relaxation/full_cell/checkpoints/
!results/mace_relaxation/full_cell/checkpoints/*.json
!results/mace_relaxation/full_cell/logs/
!results/mace_relaxation/full_cell/logs/*.log

# Step 7 elemental-reference manifests/logs are the same kind of small
# provenance artifacts and are required for strict validation and resume.
!results/mace_elemental_references/full_cell/checkpoints/
!results/mace_elemental_references/full_cell/checkpoints/*.json
!results/mace_elemental_references/full_cell/logs/
!results/mace_elemental_references/full_cell/logs/*.log

# The Step 8 benchmark checkpoint is the same kind of small provenance
# artifact and is required for strict validation and resume.
!results/mace_vs_dft/checkpoints/
!results/mace_vs_dft/checkpoints/*.json

# Large simulation outputs
*.dump
*.lammpstrj
*.restart
